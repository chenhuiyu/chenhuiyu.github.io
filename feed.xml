    </item>
    <item>
      <title>推荐也需要先想后答吗？｜生成式推荐 19：OneRec-Think</title>
      <link>https://chenhuiyu.github.io/blog/generative-recommendation-19-onerec-think-zh</link>
      <guid isPermaLink="true">https://chenhuiyu.github.io/blog/generative-recommendation-19-onerec-think-zh</guid>
      <pubDate>Wed, 29 Jul 2026 00:00:00 GMT</pubDate>
      <dc:language>zh-CN</dc:language>
      <category>Generative Recommendation</category>
